# ── PIN Auth ──────────────────────────────────────────────────────────────────
# SHA-256 hash of your 4-digit PIN.
# To generate: echo -n "1234" | sha256sum
# Or in Python: import hashlib; hashlib.sha256(b"1234").hexdigest()
PIN_HASH=

# ── VAPID (Web Push Notifications) ────────────────────────────────────────────
# Generate with: python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print('PRIVATE:', v.private_pem().decode()); print('PUBLIC:', v.public_key.public_bytes_raw().hex())"
# Or use: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com

# ── App config ────────────────────────────────────────────────────────────────
PINGS_PER_DAY=5
LAPTOP_GOAL_DAYS=90

# ── Economy ───────────────────────────────────────────────────────────────────
# The "cagnotte" (money jar) fills as days-to-laptop counts down to 0.
CAGNOTTE_TOTAL=3000
# Days credited per clean check-in (rate-limited to one credit per cooldown).
CREDIT_PER_CHECKIN=0.1
CREDIT_COOLDOWN_HOURS=1
# Bite penalty (days added) scales from MIN (far from goal) to MAX (almost there).
PENALTY_MIN=2
PENALTY_MAX=28
# Token the game-master (cron / openclaw) uses to trigger events. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=
