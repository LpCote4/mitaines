# ── PIN Auth ──────────────────────────────────────────────────────────────────
# SHA-256 hash of your 4-digit PIN.
# To generate: echo -n "1234" | sha256sum
# Or in Python: import hashlib; hashlib.sha256(b"1234").hexdigest()
PIN_HASH=

# ── VAPID (Web Push Notifications) ────────────────────────────────────────────
# Generate with: python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print('PRIVATE:', v.private_pem().decode()); print('PUBLIC:', v.public_key.public_bytes_raw().hex())"
# Or use: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com

# ── App config ────────────────────────────────────────────────────────────────
PINGS_PER_DAY=5
LAPTOP_GOAL_DAYS=90
